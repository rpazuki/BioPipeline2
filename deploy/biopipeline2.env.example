# BioPipeline2 configuration for a production VM.
#
# Copy to /etc/biopipeline2/biopipeline2.env, edit, and `chmod 640` it with
# group `biopipeline`: it carries the session secret and the database
# password. Every process reads this same file; a setting that differs
# between the API and the workers is a deployment that disagrees with itself.
#
# Everything here is a `BP_`-prefixed setting from backend/app/settings.py.
# Only the ones a deployment actually has to decide are listed; the rest have
# defaults that are right until a number proves otherwise.

# --- deployment ---
BP_ENVIRONMENT=production
# The API refuses to boot in production while this is the development
# default. Generate one: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
BP_SESSION_SECRET=replace-me
BP_LOG_LEVEL=INFO
# Set only if the platform is mounted under a path prefix, e.g. /biopipeline.
# It is also a *build* input for the frontend (NEXT_PUBLIC_BASE_PATH), so
# changing it means rebuilding the frontend.
BP_BASE_PATH=

# --- database ---
BP_DATABASE_URL=postgresql+psycopg://biopipeline:replace-me@127.0.0.1:5432/biopipeline2

# --- storage ---
# All four live on the volume you are prepared to back up and to fill.
BP_ARTIFACT_ROOT=/var/lib/biopipeline2/artifacts
BP_WORKSPACE_ROOT=/var/lib/biopipeline2/workspaces
BP_ENVIRONMENT_ROOT=/var/lib/biopipeline2/environments
BP_COMPONENT_LIBRARY_ROOT=/var/lib/biopipeline2/components
# Directories holding the science libraries tasks import, mounted read-only
# into every task container. A JSON list.
BP_TASK_LIBRARY_PATHS=[]

# --- execution ---
# Pin a tag rather than `latest`: a run records the image it used, and
# `latest` makes that record meaningless.
BP_TASK_DEFAULT_IMAGE=biopipeline2/task-base:1.0
# Admission control. Set these *below* the host's real capacity, leaving
# headroom for the API, PostgreSQL and the operating system: a task is
# claimed only when its request fits the unused remainder, which is how heavy
# work is kept sequential without a separate queue.
BP_WORKER_BUDGET_CPU_MILLICORES=4000
BP_WORKER_BUDGET_MEMORY_BYTES=12884901888
BP_WORKER_MAX_CONCURRENT_TASKS=4

# --- retention ---
# How long an output stays downloadable. The janitor is load-bearing for disk
# headroom, so this is the number that decides how big the volume must be.
BP_DEFAULT_RETENTION_DAYS=90
# How long a superseded environment build is kept after nothing references
# it. A day also leaves time to look at what an install replaced.
BP_ENVIRONMENT_GENERATION_GRACE_HOURS=24
