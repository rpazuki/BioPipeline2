    "/api/v1/pipelines": {
      "get": {
        "description": "List pipelines, newest first.\n\nCursor-based: a collection that grows without bound should not be paged by\noffset, because a row inserted mid-scan shifts every later page.",
        "operationId": "list_pipelines_api_v1_pipelines_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
